{
  "name": "ez-php/session",
  "version": "2.5.3",
  "description": "Session handler drivers (File/Database/Redis/Array), StartSession middleware, flash data, ID regeneration",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["session", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/session",
  "support": {
    "issues": "https://github.com/ez-php/session/issues",
    "source": "https://github.com/ez-php/session"
  },
  "require": {
    "php": "^8.5",
    "ez-php/contracts": "^2.0",
    "ez-php/http": "^2.0"
  },
  "suggest": {
    "ext-redis": "Needed for Driver\\RedisSessionHandler"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\Session\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
