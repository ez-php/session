# APP
APP_NAME=ez-php-session
APP_ENV=local
APP_DEBUG=true

# Uncomment and configure if this module requires MySQL:
# DB_HOST=db
# DB_HOST_PORT=3306
# DB_DATABASE=ez-php-session
# DB_USERNAME=ez-php-session
# DB_PASSWORD=ez-php-session
# DB_TESTING_DATABASE=ez-php-session_testing

# Redis — the app container reaches it as redis:6379; REDIS_HOST_PORT is the host-published port
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6387

# Uncomment and configure if this module requires Meilisearch:
# MEILISEARCH_HOST=http://meilisearch:7700
# MEILISEARCH_KEY=
# MEILISEARCH_PORT=7700
